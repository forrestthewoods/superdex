# CGAL 6.1.1, header-only, configured like superdex's CMake.
cc_static_library(
    name = "cgal",
    lang = "cpp",
    srcs = [],
    deps = Targets([ ":boost" ]),
    # glibc_shim: see glibc_shim/sys/single_threaded.h.
    public_include_dirs = RelPaths([ "cgal", "glibc_shim" ]),
    public_defines = [
        "CGAL_DISABLE_GMP=1",
        "CGAL_NO_GMP=1",
        "CGAL_NO_MPFR=1",
        "CGAL_CORE_USE_BOOST_BACKEND=1",
        # Boost 1.77's container_hash uses std::unary_function, gone in C++17.
        "BOOST_NO_CXX98_FUNCTION_BASE=1",
    ],
    public_headers = glob([
        "cgal/**/*.h*",
        "cgal/**/*.tcc",
        "glibc_shim/**/*.h*",
    ]),
)

