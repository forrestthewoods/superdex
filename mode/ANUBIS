# Modes. `precision` picks mochi's float type. Every mode is single
# precision; the fp64 Python packages override it for their own targets
# (`mode_vars = { precision = "double" }` on their py_package).
mode(
    name = "win_dev",
    vars = {
        target_platform = "windows",
        target_arch = "x64",
        build_type = "debug",
        runtime_linkage = "dynamic",
        precision = "single",
    },
)

mode(
    name = "win_release",
    vars = {
        target_platform = "windows",
        target_arch = "x64",
        build_type = "release",
        runtime_linkage = "dynamic",
        precision = "single",
    },
)

mode(
    name = "linux_dev",
    vars = {
