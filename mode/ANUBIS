# Modes. `precision` picks mochi's float type: fp64 modes build the
# double-precision Python packages (superdex-*-fp64).

mode(
    name = "win_dev",
    vars = {
        target_platform = "windows",
        target_arch = "x64",
        build_type = "debug",
        precision = "single",
    },
)

mode(
    name = "win_dev_fp64",
    vars = {
        target_platform = "windows",
        target_arch = "x64",
        build_type = "debug",
        precision = "double",
    },
)

