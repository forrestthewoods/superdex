# superdex_robotics, static, plus its gtest suite.
cc_static_library(
    name = "superdex_robotics",
    lang = "cpp",
    srcs = glob(
        includes = [ "src/**/*.cpp", "src/**/*.c" ],
        excludes = [ "**/internal/**" ],
    ),
    deps = Targets([
        "//superdex_physics/libraries/mochi/mochi_core:mochi_core",
        "//superdex_physics/libraries/mochi/mochi_physics:mochi_physics",
        "//superdex_physics/libraries/mochi/third_party/miniz:miniz",
        "//superdex_physics/libraries/mochi/third_party/tinyxml2:tinyxml2",
        "//superdex_physics/libraries/mochi/third_party/xxhash:xxhash",
        "//superdex_physics:headers",
    ]),
    public_include_dirs = RelPaths([ "include" ]),
    private_include_dirs = RelPaths([
        "src",
    ]),
    private_defines = [ "MOCHI_USE_REFLECTION=1" ],
    public_headers = glob([
        "include/**/*.h*",
    ]),
    private_headers = glob([
        "src/**/*.h*",
    ]),
)

# Needs MOCHI_ASSETS_PATH=<superdex>/assets at run time (CMake sets it via
# CTest), or run it from inside the source tree.
cc_binary(
    name = "superdex_robotics_test",
    lang = "cpp",
    srcs = glob(
        includes = [ "test/**/*.cpp", "test/**/*.c" ],
        excludes = [ "**/internal/**" ],
    ),
    deps = Targets([
        "//superdex_physics/libraries/mochi/third_party/googletest:gtest",
        ":superdex_robotics",
    ]),
    include_dirs = RelPaths([ "src" ]),
    compiler_defines = [ "MOCHI_USE_REFLECTION=1" ],
    headers = glob([
        "src/**/*.h*",
        "test/**/*.h*",
    ]),
)

# Shared build (CMake MOCHI_BUILD_SHARED=ON) for the Python extension. Links
# mochi_physics_shared rather than the static mochi_physics, so physics and
# robotics share one copy of mochi.
cc_shared_library(
    name = "superdex_robotics_shared",
    output_name = select(
        (precision) => {
            (double) = "superdex_robotics_double",
            default = "superdex_robotics",
        }
    ),
    lang = "cpp",
    srcs = glob(
        includes = [ "src/**/*.cpp", "src/**/*.c" ],
        excludes = [ "**/internal/**" ],
    ),
    deps = Targets([
        "//superdex_physics/libraries/mochi/mochi_core:mochi_core",
        "//superdex_physics/libraries/mochi/mochi_physics:mochi_physics_shared",
        "//superdex_physics/libraries/mochi/third_party/miniz:miniz",
        "//superdex_physics/libraries/mochi/third_party/tinyxml2:tinyxml2",
        "//superdex_physics/libraries/mochi/third_party/xxhash:xxhash",
        "//superdex_physics:headers",
    ]),
    public_include_dirs = RelPaths([ "include" ]),
    private_include_dirs = RelPaths([ "src" ]),
    private_defines = [
        "MOCHI_PHYSICS_EXPORTS=1",
        "MOCHI_USE_REFLECTION=1",
    ],
    public_headers = glob([
        "include/**/*.h*",
    ]),
    private_headers = glob([
        "src/**/*.h*",
    ]),
)

# The superdex_robotics Python extension (CMake: pybind/CMakeLists.txt).
py_extension(
    name = "superdex_robotics_py",
    module = select(
        (precision) => {
            (double) = "superdex_robotics_double",
            default = "superdex_robotics",
        }
    ),
    lang = "cpp",
    srcs = glob(
        includes = [ "pybind/src/**/*.cpp" ],
        excludes = [ "**/internal/**" ],
    ),
    deps = Targets([
        "//superdex_physics/libraries/mochi/mochi_core:mochi_core",
        "//superdex_physics/libraries/mochi/mochi_physics:mochi_physics_shared",
        "//superdex_physics/libraries/mochi/mochi_physics:mochi_pybind_core",
        "//superdex_physics/libraries/mochi/third_party/pybind11:pybind11",
        "//superdex_physics/libraries/mochi:mochi_root",
        ":superdex_robotics_shared",
    ]),
    private_include_dirs = RelPaths([ "pybind/src" ]),
    private_defines = [ "MOCHI_USE_REFLECTION=1" ],
    private_headers = glob([
        "pybind/src/**/*.h*",
    ]),
)
