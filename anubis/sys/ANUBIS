# Linux system libraries the studio uses but no toolchain ships.
#
# Headers: Debian -dev packages fetched by Natron into toolchains/x11 (see
# natron.toml; target //toolchains:x11_headers). Libraries: link-only stubs built from checked-in .ifs files
# (Anubis `ifs_stub_library`); the real libX11.so.6 is loaded at run time.
#
# libX11.ifs was made once with:
#   llvm-ifs --input-format=ELF --output-ifs=libX11.ifs /usr/lib/x86_64-linux-gnu/libX11.so.6
# from Ubuntu 24.04's libx11-6 1.8.7. Only XSetErrorHandler is linked directly
# today (imguios); glfw and Filament dlopen libX11/libGL themselves.
ifs_stub_library(
    name = "libX11",
    ifs = RelPath("libX11.ifs"),
)

cc_static_library(
    name = "x11",
    lang = "c",
    srcs = [],
    deps = Targets([ "//toolchains:x11_headers", ":libX11" ]),
)
