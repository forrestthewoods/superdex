py_wheel(
    name = "mesh_cli_wheel",
    package = Target(":mesh_cli"),
    project = RelPath("superdex_mesh_cli"),
    srcs = glob(
        includes = [ "superdex_mesh_cli/README.md", "superdex_mesh_cli/LICENSE", "superdex_mesh_cli/thirdparty_licenses/**/*", "superdex_mesh_cli/superdex_mesh_cli/**/*" ],
        excludes = [ "**/__pycache__/**" ],
    ),
