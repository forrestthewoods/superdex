# GoogleTest, as one translation unit (gtest-all.cc).
cc_static_library(
    name = "gtest",
    lang = "cpp",
    srcs = RelPaths([ "googletest/src/gtest-all.cc" ]),
    public_include_dirs = RelPaths([ "googletest/include" ]),
    private_include_dirs = RelPaths([ "googletest" ]),
    private_compiler_flags = [ "-std=gnu++20", "-w" ],
    public_headers = glob([
        "googletest/include/**/*.h*",
    ]),
    private_headers = glob([
        "googletest/**/*.h*",
    ]),
)

cc_static_library(
    name = "gtest_main",
    lang = "cpp",
    srcs = RelPaths([ "googletest/src/gtest_main.cc" ]),
    deps = Targets([ ":gtest" ]),
    private_compiler_flags = [ "-std=gnu++20", "-w" ],
    private_headers = glob([
        "googletest/src/**/*.h*",
    ]),
)
